# Copy to .env for LOCAL pipeline runs only. Never commit .env. In GitHub, use Actions secrets/variables.
# --- Secrets (GitHub: Settings → Secrets and variables → Actions → Secrets) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SECRET_KEY
LLM_API_KEY=
SEARCH_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# --- Non-secret variables (GitHub: ... → Variables) ---
LLM_PROVIDER=none            # none | openai_compatible | anthropic
LLM_BASE_URL=                # e.g. an OpenAI-compatible endpoint; blank = provider default
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
LLM_PRICE_INPUT_PER_M=0      # USD per 1M input tokens, from your provider's pricing page
LLM_PRICE_OUTPUT_PER_M=0
DAILY_BUDGET_USD=0.50
SEARCH_PROVIDER=none         # none | brave | exa
