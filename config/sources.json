 {
  "id": "hn-ai",
  "name": "Hacker News (AI)",
  "adapter": "hackernews",
  "config": {
   "queries": [
    "LLM",
    "AI agent",
    "MCP",
    "open source model",
    "Claude",
    "GPT",
    "Gemini",
    "Ollama"
   ],
