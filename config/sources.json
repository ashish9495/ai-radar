 {
  "id": "gh-new-ai-repos",
  "name": "GitHub — rising AI repos",
  "adapter": "github_search",
  "config": {
   "queries": [
    "topic:llm",
    "topic:ai-agents",
    "topic:mcp",
    "topic:mcp-server",
    "topic:self-hosted topic:ai"
   ],
   "created_within_days": 30,
   "min_stars": 80,
   "per_query": 10
  },
  "reliability": 2,
  "is_official": false,
  "interval_minutes": 180,
  "default_category": "open-source",
  "homepage": "https://github.com/search",
  "notes": "Stars are not a reliability signal",
  "enabled": true
 },
