# Browser-safe values only. These end up in the public JavaScript bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase "publishable" key (sb_publishable_...) or legacy anon key. Safe ONLY because RLS is enforced.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# "/ai-radar" for https://<user>.github.io/ai-radar/ ; empty for a custom domain
NEXT_PUBLIC_BASE_PATH=
